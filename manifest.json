{
  "manifest_version": 3,
  "name": "Vinted Relist",
  "version": "1.8.0",
  "description": "Ripubblica un articolo Vinted con un clic: clona l'annuncio (foto e dati) e rimuove quello vecchio.",
  "permissions": [
    "storage",
    "webRequest",
    "alarms",
    "notifications",
    "idle"
  ],
  "host_permissions": [
    "https://www.vinted.it/*",
    "https://www.vinted.fr/*",
    "https://www.vinted.es/*",
    "https://www.vinted.de/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.com/*",
    "https://www.vinted.be/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.at/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.pl/*",
    "https://www.vinted.cz/*",
    "https://www.vinted.sk/*",
    "https://www.vinted.lt/*",
    "https://www.vinted.lu/*",
    "https://www.vinted.ro/*",
    "https://www.vinted.hu/*",
    "https://*.vinted.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.it/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.es/*",
        "https://www.vinted.de/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*",
        "https://www.vinted.be/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.at/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.ro/*",
        "https://www.vinted.hu/*"
      ],
      "js": [
        "src/utils.js",
        "src/api.js",
        "src/relist.js",
        "src/queue.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.vinted.it/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.es/*",
        "https://www.vinted.de/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*",
        "https://www.vinted.be/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.at/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.ro/*",
        "https://www.vinted.hu/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Vinted Relist",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
